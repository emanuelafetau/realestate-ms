@startuml REMS_06_Notification_Matching

'──────────────────────────────────────────────────
'  REMS – Diagram 6 of 6: Notification & Matching
'──────────────────────────────────────────────────

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam ArrowColor #555555
skinparam classHeaderBackgroundColor #E1BEE7
skinparam classBorderColor #6A1B9A
skinparam packageBackgroundColor #FAF5FF
skinparam packageBorderColor #6A1B9A
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #FBC02D
skinparam linetype polyline

title REMS – Notification & Matching Domain

' ═══════════════════════════════
' ENUMS
' ═══════════════════════════════

enum NotificationEventType {
  VIEWING_REMINDER_24H
  VIEWING_REMINDER_2H
  CLIENT_FOLLOW_UP_OVERDUE
  DEAL_STAGE_STALLED
  PROPERTY_STALE_LISTING
  COMMISSION_RECEIPT_OVERDUE
  PROPERTY_MATCH_FOUND
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  COMMERCIAL
  LAND
}

' ═══════════════════════════════
' NOTIFICATION CLASSES
' ═══════════════════════════════

package "Notification" #FAF5FF {

  class Notification {
    + id : UUID
    + agentId : UUID
    + eventType : NotificationEventType
    + title : String
    + body : String
    + isRead : Boolean
    + sentAt : DateTime
    + linkedEntityId : UUID
    + linkedEntityType : String
    --
    + markAsRead() : void
    + dismiss() : void
  }

  class NotificationPreference {
    + id : UUID
    + agentId : UUID
    + eventType : NotificationEventType
    + isEnabled : Boolean
    + timingOffsetHours : Int
    --
    + update(isEnabled : Boolean, offset : Int) : void
  }

  note right of NotificationPreference
    One preference record
    per event type per agent.
  end note
}

' ═══════════════════════════════
' MATCHING CLASSES
' ═══════════════════════════════

package "Matching" #F0FFF4 {

  class MatchQuery {
    + clientId : UUID
    + budgetMax : Decimal
    + location : String
    + propertyType : PropertyType
    + excludeShownProperties : Boolean
    --
    + execute() : List<MatchResult>
  }

  class MatchResult {
    + id : UUID
    + clientId : UUID
    + propertyId : UUID
    + score : Decimal
    + generatedAt : DateTime
    + aiDraftMessage : String
    --
    + generateDraftMessage() : String
    + sendDraftViaWhatsApp() : void
  }

  note right of MatchResult
    aiDraftMessage generated by
    OpenAI API (AIService).
    Sent via WhatsApp deep-link.
  end note
}

' ═══════════════════════════════
' REPORTING CLASSES
' ═══════════════════════════════

package "Reporting" #FFFBF0 {

  class KPIDashboard {
    + totalActiveClients : Int
    + totalActiveListings : Int
    + viewingsThisMonth : Int
    + dealsClosedThisMonth : Int
    + dealsClosedYTD : Int
    + commissionsEarnedThisMonth : Decimal
    + monthlyTarget : Decimal
    + targetProgress : Decimal
    --
    + refresh() : void
  }

  class PerformanceReport {
    + periodStart : Date
    + periodEnd : Date
    + dealsOpened : Int
    + dealsClosed : Int
    + commissionEarned : Decimal
    + totalExpenses : Decimal
    + clientPipelineMovement : String
    --
    + generate(start : Date, end : Date) : PerformanceReport
    + exportPDF() : Blob
    + exportSpreadsheet() : Blob
  }

  class PropertyActivityReport {
    + propertyId : UUID
    + daysOnMarket : Int
    + totalViewings : Int
    + totalSuggested : Int
    + lastStatusChange : DateTime
    --
    + generateForAllActive() : List<PropertyActivityReport>
  }

  note bottom of KPIDashboard
    All reporting classes are
    computed views — not stored entities.
  end note
}

' ═══════════════════════════════
' CROSS-DIAGRAM REFERENCES
' ═══════════════════════════════

class Client <<(R,#AAAAAA) ref>> {
  + id : UUID
  + fullName : String
  + budgetMax : Decimal
}

note top of Client
  Defined in
  Diagram 1: Client
end note

class Property <<(R,#AAAAAA) ref>> {
  + id : UUID
  + askingPrice : Decimal
}

note top of Property
  Defined in
  Diagram 2: Property
end note

' ═══════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════

Notification --> NotificationEventType : eventType
NotificationPreference --> NotificationEventType : preferenceFor

Client "1" --> "0..*" Notification : receives
Client "1" --> "0..*" NotificationPreference : configures

MatchQuery "1" --> "0..*" MatchResult : produces

MatchQuery --> Client : searchesFor
MatchQuery --> Property : filters

MatchResult --> Client : matchedTo
MatchResult --> Property : suggests

KPIDashboard --> Client : aggregates
KPIDashboard --> Property : aggregates

PropertyActivityReport --> Property : analyses

@enduml